generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Vehicle {
  id               Int      @id @default(autoincrement())
  brand            String
  model            String
  version          String?
  year             Int
  category         Category
  consumptionCityG Float?
  consumptionHwyG  Float?
  consumptionCityE Float?
  consumptionHwyE  Float?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  consumptionCityD Float?
  consumptionHwyD  Float?
  fullName         String?

  @@index([brand, model])
}

model User {
  id        String   @id @default(uuid())
  username  String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  jobRole   JobRole
}

enum Category {
  HATCH
  SEDAN
  SUV
  PICKUP
  COUPE
  VAN
  ELECTRIC
  MOTO
}

enum JobRole {
  SUPERUSER
  ADMIN
  USER
}
